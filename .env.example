# Copy to .env and fill in. Every value here has a working default except SECRET_KEY,
# which you should set to something random before putting this on the internet.

# Signs the session cookie. Generate with: python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Postgres connection string. Hosts hand this out ready-made; the postgres:// and
# postgresql:// forms are both accepted. Locally this defaults to a database called
# leetstreak_dev on your own machine, so you can leave it blank.
#   createdb leetstreak_dev && createdb leetstreak_test
DATABASE_URL=

# Cap on pooled connections. Lower it on a free serverless Postgres, which allows
# only a handful.
DB_POOL_MAX=5

# Public origin, used to build OAuth redirect + invite links.
BASE_URL=http://localhost:8000

# --- GitHub sign-in (optional; email + password always works) -------------------
# Create at https://github.com/settings/developers -> "New OAuth App".
# Authorization callback URL must be  <BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Google sign-in (optional) --------------------------------------------------
# Google Cloud console -> APIs & Services -> Credentials -> "OAuth client ID",
# application type "Web application".
# Authorised redirect URI must be  <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sending the sign-up verification code -------------------------------------
# Pick ONE. With neither set, codes are written to the server log instead of being
# delivered, which is fine on your laptop and useless once friends are signing up.
#
# Option A: any SMTP server. For Gmail you need an App Password, not your login
# password (Google account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
#
# Option B: Resend (https://resend.com), free tier is plenty for a friend group.
RESEND_API_KEY=

# The From: address on that email. Must be a domain you are allowed to send as.
MAIL_FROM=LeetStreak <no-reply@localhost>

# --- GitHub data access (optional) ---------------------------------------------
# A classic PAT with no scopes (public data only) is enough. Without it the
# GitHub source is skipped: unauthenticated GitHub API allows only 60 req/hour
# and the contributions calendar requires auth outright.
GITHUB_TOKEN=

# --- Behaviour -----------------------------------------------------------------
# Whether strangers can create accounts. Set to false once your friends have all
# registered and you want the door shut. Defaults to true.
ALLOW_REGISTRATION=

# How long cached activity stays fresh before a page view triggers a refresh.
SYNC_TTL_SECONDS=900

# Shared secret for POST /api/cron/sync so you can refresh everyone from cron.
CRON_TOKEN=
